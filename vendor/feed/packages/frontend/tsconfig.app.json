{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "allowUnusedLabels": true,
    "types": ["vitest/globals"],

    /* Linting */
    "strict": true,
    /*
     * noUnusedLocals / noUnusedParameters intentionally disabled. Both
     * categories are noise as tsc errors (~241 pre-existing combined)
     * and are better handled by ESLint's `no-unused-vars` rule, which
     * can autofix and is configurable per-call-site. See
     * docs/TSC-DEBT.md.
     */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
