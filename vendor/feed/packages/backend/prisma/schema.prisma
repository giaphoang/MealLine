generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GlobalLimit {
  id        Int      @id @default(autoincrement())
  value     Int      @default(10)
  updatedAt DateTime @updatedAt
}

// B1: org-wide shared Export Settings for shopping-list PDF filenames
// (ISSUES.md #34). A single shared row (id = 1, upserted) — no per-user
// scoping, per the shared-environment principle (#31).
model ExportSettings {
  id                  Int      @id @default(autoincrement())
  includeDate         Boolean  @default(true)
  datePosition        String   @default("end")
  includeTemplateName Boolean  @default(true)
  includeLanguage     Boolean  @default(true)
  previewBaseName     String   @default("Shopping List")
  translatedBaseName  String   @default("Shopping List")
  updatedAt           DateTime @updatedAt
}

// Deployment capabilities: what this installation does, as distinct from what
// it looks like. Separate from BrandConfiguration on purpose — whether the
// public inventory feed is served is an operational data-sharing decision, not
// brand identity, and storing it in the appearance payload meant it could only
// be changed by editing an appearance (and was unreachable while the compiled
// default was active). Singleton, following LottoQueueIntegrationConfig.
model DeploymentSettings {
  id                    String   @id @default("singleton")
  publicInventoryEnabled Boolean @default(true)
  updatedBy             String?
  updatedAt             DateTime @updatedAt
}

// One deployment-wide appearance configuration. Drafts and the two built-in
// templates may coexist, but a partial unique index in the migration permits
// only one row with isActive = true. Brand inputs are stored in payload; the
// derived token map is always regenerated by the current application code.
model BrandConfiguration {
  id         String   @id
  payload    Json
  isActive   Boolean  @default(false)
  isTemplate Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Uploaded identity assets live in SQLite so they travel with the sanitized
// portable backup. Base64 keeps the logical JSON backup format portable across
// Prisma/SQLite runtimes without special Buffer revival during restore.
model BrandAsset {
  id         String   @id
  filename   String
  mimeType   String
  width      Int
  height     Int
  dataBase64 String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Append-only organization-wide pantry schedules. The latest revision whose
// effectiveDate is on or before a local service date governs that date.
// Multiple same-day corrections are retained; the last recorded one applies.
model OperatingHoursRevision {
  id            Int      @id @default(autoincrement())
  effectiveDate String
  timezone      String
  hours         Json
  revisionKind  String   @default("updated")
  recordedAt    DateTime @default(now())

  @@index([effectiveDate, recordedAt])
}

model Category {
  id                   Int                      @id @default(autoincrement())
  name                 String
  nameSearch           String                   @unique
  limit                Int                      @default(10)
  limitType            String                   @default("household")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  icon                 String?                  @default("package")
  translations         CategoryTranslation[]
  foodItems            FoodItem[]
  shoppingListSections ShoppingListSection[]
  inventoryEvents      CategoryInventoryEvent[]
}

model CategoryTranslation {
  id         Int      @id @default(autoincrement())
  categoryId Int
  language   String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
}

model FoodItem {
  id                Int                      @id @default(autoincrement())
  name              String
  nameSearch        String                   @unique
  limit             Int                      @default(10)
  limitType         String                   @default("household")
  isInStock         Boolean                  @default(true)
  isLimited         Boolean                  @default(false)
  isClearance       Boolean                  @default(false)
  categoryId        Int
  vegan             Boolean                  @default(false)
  vegetarian        Boolean                  @default(false)
  glutenFree        Boolean                  @default(false)
  organic           Boolean                  @default(false)
  halal             Boolean                  @default(false)
  kosher            Boolean                  @default(false)
  readyToEat        Boolean                  @default(false)
  // Exact stock used by Nourish household baskets; separate from optional supply estimates.
  quantity          Int                      @default(0)
  unit              String                   @default("unit")
  requiresStove     Boolean                  @default(false)
  requiresFridge    Boolean                  @default(false)
  // Optional Supply annotations. They never drive availability or imply a
  // unit of measure (docs/reports/operational-analytics-design.md).
  estimatedQuantity Int?
  supplySource      String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  category          Category                 @relation(fields: [categoryId], references: [id])
  translations      FoodItemTranslation[]
  inventoryEvents   FoodItemInventoryEvent[]
}

// Organization-wide shared report templates (Reports initiative §3). No
// owner/user scoping — every authenticated user sees the same set (the
// shared-environment principle, AGENTS.md). `source` is immutable and
// binds the template to 'reports' or 'dashboard' cards; names are unique
// per source (normalized). templateData is versioned JSON holding ordered
// card ids, range preset or exact custom dates, timezone, filters, and
// horizon — never computed data or generated files.
model ReportTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  nameSearch   String
  source       String
  templateData Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([source, nameSearch])
}

// Organization-wide provenance for transient external-data imports. Uploaded
// source files are parsed from memory and discarded; only normalized records,
// hashes, validation summaries, and reversible lifecycle state are retained.
model ProcurementImport {
  id            Int       @id @default(autoincrement())
  source        String
  fileHash      String
  schemaVersion Int       @default(1)
  status        String    @default("active")
  rowCount      Int
  orderCount    Int
  warningCount  Int       @default(0)
  warnings      Json      @default("[]")
  rangeStart    String
  rangeEnd      String
  importedBy    String?
  importedAt    DateTime  @default(now())
  rolledBackBy  String?
  rolledBackAt  DateTime?
  restoredBy    String?
  restoredAt    DateTime?

  // Hash of the original unified export file this import was extracted from.
  // A unified upload always produces two ProcurementImport rows -- one
  // Warehouse, one Fresh Alliance, permanently separate source namespaces
  // (D3) -- and this ties them back together as one upload action. Null for
  // an import that predates this column; every import created from this
  // point forward has it, since the unified export is the only accepted
  // format.
  unifiedFileHash String?

  orders ProcurementOrderRevision[]

  @@index([source, importedAt])
  @@index([unifiedFileHash])
  @@index([fileHash])
  @@index([status, importedAt])
}

// One immutable source-event snapshot for one OFB Order # reference. References
// ending in AGPCKUP are Fresh Food Alliance Receipts; all other OFB references
// are Warehouse Orders. A later snapshot appends a revision without
// manufacturing a second identity.
model ProcurementOrderRevision {
  id                   Int      @id @default(autoincrement())
  importId             Int
  source               String
  sourceOrderReference String
  eventKind            String   @default("ofb_warehouse_order")
  deliveryDate         String
  revision             Int
  snapshotHash         String
  warningCodes         Json
  isCurrent            Boolean  @default(true)
  createdAt            DateTime @default(now())

  // Agency Pickups provenance. Null for Completed Orders revisions, which
  // report no donor. FEED records the donor the source reports and never
  // infers one. `pickupTime` is null when the source emitted its 12:00 AM
  // missing-time placeholder.
  sourcePickupId String?
  pickupTime     String?
  submittedAt    String?
  donorCode      String?
  donorName      String?

  // Whether OFB has reviewed and confirmed this Fresh Alliance receipt
  // (Primarius's own `SystemReceived` flag, reported not inferred). Null for
  // OFB Warehouse revisions, where the concept does not apply -- Warehouse
  // orders are never imported except Completed. Every Fresh Alliance import
  // through the current 19-column contract sets this true, because that
  // contract structurally can only carry OFB-confirmed rows today. See
  // fresh-alliance-pending-pickups.md (D13).
  isConfirmed Boolean?

  // Set when a Fresh Alliance import covers this event's receiving date, so
  // the donor-attributed observation replaces the Completed Orders AGPCKUP
  // observation of the same event without deleting it. Cleared when that
  // import is rolled back. See procurement-unification-plan.md (D1).
  supersededByImportId Int?

  import ProcurementImport @relation(fields: [importId], references: [id])
  lines  ProcurementLine[]

  @@unique([source, sourceOrderReference, revision])
  @@index([source, sourceOrderReference, isCurrent])
  @@index([source, eventKind, deliveryDate, isCurrent])
  @@index([source, deliveryDate, isCurrent])
  @@index([importId])
  @@index([snapshotHash])
  @@index([supersededByImportId])
  @@index([donorCode])
  @@index([source, isConfirmed])
}

// Stable identity supplied by the source system. Descriptions remain on each
// line because OFB text changes and contains historical spelling variations.
model ProcurementProduct {
  id               Int               @id @default(autoincrement())
  source           String
  productCode      String
  acquisitionClass String
  createdAt        DateTime          @default(now())
  lines            ProcurementLine[]

  @@unique([source, productCode])
  @@index([acquisitionClass])
}

// Immutable normalized line observation. Monetary values use integer cents;
// quantity and weight use integer hundredths to match the exporter contract.
// The source and calculated price totals are both retained so deterministic
// reconciliation never overwrites provenance.
model ProcurementLine {
  id                        Int     @id @default(autoincrement())
  orderRevisionId           Int
  productId                 Int
  sourceRowNumber           Int
  sourceOrderReference      String
  sourcePeriod              String
  sourceDescription         String
  acquisitionClass          String
  procurementChannel        String
  quantityHundredths        Int
  weightHundredths          Int
  unitPriceCents            Int
  sourcePriceTotalCents     Int
  calculatedPriceTotalCents Int
  priceTotalMatches         Boolean
  serviceFeeCents           Int
  grantsAppliedCents        Int

  // Agency Pickups observations. Null on Completed Orders lines, which report
  // none of these. `donorValuePerPoundCents` of 0 with
  // `hasDonorValuation = false` means OFB recorded no valuation — not a
  // zero-value donation. 29% of historical poundage arrives this way, so the
  // weight must never be dropped and value must never be imputed from a rate.
  sourcePickupLineId         String?
  freshAllianceCategory      String?
  receivedQuantityHundredths Int?
  receivedWeightHundredths   Int?
  receivedMatchesRequested   Boolean?
  donorValuePerPoundCents    Int?
  hasDonorValuation          Boolean?

  orderRevision ProcurementOrderRevision @relation(fields: [orderRevisionId], references: [id])
  product       ProcurementProduct       @relation(fields: [productId], references: [id])

  @@unique([orderRevisionId, sourceRowNumber])
  @@index([productId, orderRevisionId])
  @@index([acquisitionClass])
  @@index([procurementChannel])
}

// A non-destructive classification overlay on procurement observations (D19).
// Events are immutable facts; a rule never edits, hides, or deletes one -- it
// records how this agency interprets it, and each Analytics view decides which
// flags it honors. That is what lets "received" and "retained inventory" be
// different, equally honest answers drawn from the same rows (D21).
//
// Rules are the agency's own operational truth, authored in Data Management
// (D20) -- never shipped as system logic. FEED cannot know that a given
// pickup is a courier run for another agency; only the agency does.
//
// Evaluated at read time rather than materialized at import, so adding or
// disabling a rule reshapes existing data without a re-import. That is
// precisely what makes the per-import Actions menu able to reshape
// retroactively rather than only roll back.
model ProcurementDataRule {
  id Int @id @default(autoincrement())

  // The classification applied. Exclusion flags (pass_through,
  // other_exclusion) change a metric's total; annotation flags (at_risk, estimated,
  // program_bound) change meaning and confidence but never the math. The
  // family is derived from the flag in code, not stored, so the two can never
  // drift apart -- see FLAG_FAMILY in services/procurement/data-shaping.ts.
  flag String

  // Narrowest scope that is true: 'donor' | 'category' | 'date_range' |
  // 'event'. Stored explicitly rather than inferred from which matchers are
  // populated, so an ambiguous rule cannot be persisted and the UI can group
  // rules by the intent the author actually had.
  scope String

  // Primary matcher -- the one the scope requires; the others stay null. A
  // donor rule may carry either identifier or both: OFB's donor codes are
  // stabler than its names, which demonstrably drift, while legacy rows carry
  // only a canonical name and no code. Either one matching is enough.
  donorName       String?
  donorCode       String?
  productCode     String?
  orderRevisionId Int?

  // General narrowers, available to any scope. `source` absent means every
  // namespace, which is what lets one donor rule (New Seasons -> pass_through)
  // cover both live OFB data and legacy history without being restated.
  // Dates are inclusive ISO `YYYY-MM-DD`, which compares correctly as text.
  source    String?
  startDate String?
  endDate   String?

  enabled Boolean @default(true)

  // Why the agency set this. Institutional knowledge the data itself cannot
  // carry; it belongs with the rule rather than in someone's memory.
  note String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, scope])
  @@index([donorName])
  @@index([donorCode])
  @@index([orderRevisionId])
}

// Organization-wide provenance for formal Service imports. Procurement keeps
// its mature lifecycle model; the unified Add Data experience routes here only
// after the source classifier identifies a Service dataset. Uploaded files are
// never retained.
model ServiceImport {
  id                 Int                                @id @default(autoincrement())
  source             String
  datasetKind        String
  fileHash           String
  schemaVersion      Int                                @default(1)
  status             String                             @default("active")
  rowCount           Int
  warningCount       Int                                @default(0)
  warnings           Json                               @default("[]")
  rangeStart         String?
  rangeEnd           String?
  importedBy         String?
  importedAt         DateTime                           @default(now())
  rolledBackBy       String?
  rolledBackAt       DateTime?
  restoredBy         String?
  restoredAt         DateTime?
  encounters         ServiceEncounterRevision[]
  clientProfiles     ServiceClientProfileRevision[]
  personProfiles     ServicePersonProfileRevision[]
  metricObservations ServiceMetricObservationRevision[]
  qualityIssues      ServiceQualityIssue[]
  lottoSessions      LottoQueueSessionRevision[]

  @@index([source, datasetKind, importedAt])
  @@index([fileHash])
  @@index([status, importedAt])
}

// Privacy-minimized LOTTO closeouts. Queue tickets are operational timing
// observations, never visits, households, clients, or people.
model LottoQueueSessionRevision {
  id                         Int                    @id @default(autoincrement())
  summaryId                  String                 @unique
  sessionId                  String
  revision                   Int
  supersedesSummaryId        String?
  contentHash                String
  isCurrent                  Boolean                @default(true)
  source                     String
  serviceDate                String
  timezone                   String
  sessionStartedAt           DateTime?
  closedAt                   DateTime
  recordedAt                 DateTime
  mode                       String
  timingCoverage             String
  operatingWindow            Json?
  configuredCount            Int
  issuedCount                Int
  calledCount                Int
  unclaimedCount             Int
  returnedCount              Int
  notCalledCount             Int
  unpairedCallCount          Int
  allIssuedTicketsCalled     Boolean
  switchedRandomToSequential Boolean
  appendedTickets            Boolean
  initialDisposition         String                 @default("needs_review")
  rulesVersion               Int                    @default(1)
  facts                      Json
  importId                   Int?
  syncRunId                  Int?
  createdAt                  DateTime                @default(now())
  import                     ServiceImport?          @relation(fields: [importId], references: [id])
  syncRun                    LottoQueueSyncRun?       @relation(fields: [syncRunId], references: [id])
  ticketObservations         LottoQueueTicketObservation[]
  qualityIssues              LottoQueueQualityIssue[]

  @@unique([sessionId, revision])
  @@unique([sessionId, contentHash])
  @@index([sessionId, isCurrent])
  @@index([serviceDate, isCurrent])
  @@index([initialDisposition, serviceDate])
}

model LottoQueueTicketObservation {
  id                Int                       @id @default(autoincrement())
  sessionRevisionId Int
  sequence          Int
  batchSequence     Int?
  issuedAt          DateTime?
  firstCalledAt     DateTime?
  outcome           String
  sessionRevision   LottoQueueSessionRevision @relation(fields: [sessionRevisionId], references: [id], onDelete: Cascade)

  @@unique([sessionRevisionId, sequence])
  @@index([firstCalledAt])
}

model LottoQueueQualityIssue {
  id                Int                       @id @default(autoincrement())
  sessionRevisionId Int
  code              String
  severity          String
  safeDetails       Json                      @default("{}")
  createdAt         DateTime                  @default(now())
  sessionRevision   LottoQueueSessionRevision @relation(fields: [sessionRevisionId], references: [id], onDelete: Cascade)

  @@unique([sessionRevisionId, code])
  @@index([code, severity])
}

// Staff classification is append-only and bound to an exact immutable source
// revision. A corrected LOTTO revision is classified independently.
model LottoQueueSessionResolution {
  id             Int      @id @default(autoincrement())
  sessionId      String
  sourceRevision Int
  revision       Int
  disposition    String
  reason         String
  createdBy      String?
  createdAt      DateTime @default(now())

  @@unique([sessionId, revision])
  @@index([sessionId, sourceRevision, createdAt])
}

model LottoQueueIntegrationConfig {
  id             String   @id @default("singleton")
  baseUrl        String
  encryptedToken String
  salt           String
  cursor         String?
  lastSyncedAt   DateTime?
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

model LottoQueueSyncRun {
  id             Int                        @id @default(autoincrement())
  mode           String
  status         String
  cursorBefore   String?
  cursorAfter    String?
  receivedCount  Int                        @default(0)
  insertedCount  Int                        @default(0)
  unchangedCount Int                        @default(0)
  reviewCount    Int                        @default(0)
  errorCode      String?
  errorMessage   String?
  startedBy      String?
  startedAt      DateTime                   @default(now())
  completedAt    DateTime?
  sessions       LottoQueueSessionRevision[]

  @@index([startedAt])
  @@index([status, startedAt])
}

// Stable identity inside one formal intake source. Link2Feed and SIMC ids are
// deliberately different namespaces and are never matched to each other.
// Anonymous encounters have no ServiceClient row.
model ServiceClient {
  id               Int                            @id @default(autoincrement())
  source           String
  sourceClientId   String
  createdAt        DateTime                       @default(now())
  encounters       ServiceEncounterRevision[]
  profileRevisions ServiceClientProfileRevision[]

  @@unique([source, sourceClientId])
  @@index([source])
}

// Stable person identity inside one formal source. SIMC Household ID remains
// the ServiceClient/case identity used by encounters; Neighbor ID belongs here
// so household and person denominators cannot be conflated. Source namespaces
// are never matched automatically across intake systems.
model ServicePerson {
  id               Int                            @id @default(autoincrement())
  source           String
  sourcePersonId   String
  createdAt        DateTime                       @default(now())
  profileRevisions ServicePersonProfileRevision[]
  encounterLinks   ServiceEncounterPerson[]

  @@unique([source, sourcePersonId])
  @@index([source])
}

// One immutable interpretation of one source observation. Later imports append
// revisions; they do not overwrite source history. `reportedPeopleCount` is a
// source-reported measure, not necessarily a household-size observation.
model ServiceEncounterRevision {
  id                     Int                            @id @default(autoincrement())
  importId               Int
  clientId               Int?
  source                 String
  sourceRecordKey        String
  serviceDate            String
  revision               Int
  snapshotHash           String
  recordKind             String
  clientVisitStatus      String                         @default("unknown")
  reportedHouseholdCount Int?
  reportedPeopleCount    Int?
  sourceEventId          String?
  sourceRecordedAt       String?
  numberAdults           Int?
  numberChildren         Int?
  numberSeniors          Int?
  numberUnknownAge       Int?
  warningCodes           Json                           @default("[]")
  isCurrent              Boolean                        @default(true)
  createdAt              DateTime                       @default(now())
  import                 ServiceImport                  @relation(fields: [importId], references: [id])
  client                 ServiceClient?                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  profileRevisions       ServiceClientProfileRevision[]
  people                 ServiceEncounterPerson[]

  @@unique([source, sourceRecordKey, revision])
  @@index([source, sourceRecordKey, isCurrent])
  @@index([source, serviceDate, isCurrent])
  @@index([importId])
  @@index([clientId, serviceDate])
  @@index([snapshotHash])
  @@index([recordKind])
}

// One identified person represented in one immutable encounter revision.
// A new encounter revision receives a new membership set; old membership stays
// attached to the old interpretation for auditability.
model ServiceEncounterPerson {
  id                  Int                      @id @default(autoincrement())
  encounterRevisionId Int
  personId            Int
  isHeadOfHousehold   Boolean                  @default(false)
  encounter           ServiceEncounterRevision @relation(fields: [encounterRevisionId], references: [id], onDelete: Restrict)
  person              ServicePerson            @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([encounterRevisionId, personId])
  @@index([personId, encounterRevisionId])
}

// Immutable client/profile evidence from either a visit-linked row or a
// standalone client export. Full dates of birth are transformed to birth year
// before this boundary. A profile may be tied to the encounter that supplied
// it, while standalone client imports remain order-independent.
model ServiceClientProfileRevision {
  id                      Int                            @id @default(autoincrement())
  importId                Int
  clientId                Int
  encounterRevisionId     Int?
  source                  String
  sourceProfileKey        String
  observedDate            String?
  revision                Int
  snapshotHash            String
  birthYear               Int?
  birthYearEstimated      Boolean?
  birthYearResponseStatus String                         @default("not_provided")
  isCurrent               Boolean                        @default(true)
  createdAt               DateTime                       @default(now())
  import                  ServiceImport                  @relation(fields: [importId], references: [id])
  client                  ServiceClient                  @relation(fields: [clientId], references: [id])
  encounter               ServiceEncounterRevision?      @relation(fields: [encounterRevisionId], references: [id], onDelete: Restrict)
  responses               ServiceClientProfileResponse[]

  @@unique([source, sourceProfileKey, revision])
  @@index([source, sourceProfileKey, isCurrent])
  @@index([clientId, observedDate, isCurrent])
  @@index([importId])
  @@index([encounterRevisionId])
}

// One canonical question/dimension on one profile revision. Values are a JSON
// string array because several reviewed dimensions are multi-select; the
// dimension and response-status vocabularies are closed and validated in the
// Service domain layer. Non-answer source labels never persist as values.
model ServiceClientProfileResponse {
  id                Int                          @id @default(autoincrement())
  profileRevisionId Int
  dimension         String
  responseStatus    String
  values            Json                         @default("[]")
  profileRevision   ServiceClientProfileRevision @relation(fields: [profileRevisionId], references: [id])

  @@unique([profileRevisionId, dimension])
  @@index([dimension, responseStatus])
}

// Immutable person-level evidence. SIMC supplies one Neighbor profile across
// many household visits; the latest normalized observation in each artifact
// becomes a revision only when its snapshot changes.
model ServicePersonProfileRevision {
  id                      Int                            @id @default(autoincrement())
  importId                Int
  personId                Int
  source                  String
  sourceProfileKey        String
  observedDate            String?
  revision                Int
  snapshotHash            String
  birthYear               Int?
  birthYearEstimated      Boolean?
  birthYearResponseStatus String                         @default("not_provided")
  isCurrent               Boolean                        @default(true)
  createdAt               DateTime                       @default(now())
  import                  ServiceImport                  @relation(fields: [importId], references: [id])
  person                  ServicePerson                  @relation(fields: [personId], references: [id])
  responses               ServicePersonProfileResponse[]

  @@unique([source, sourceProfileKey, revision])
  @@index([source, sourceProfileKey, isCurrent])
  @@index([personId, observedDate, isCurrent])
  @@index([importId])
}

model ServicePersonProfileResponse {
  id                Int                          @id @default(autoincrement())
  profileRevisionId Int
  dimension         String
  responseStatus    String
  values            Json                         @default("[]")
  profileRevision   ServicePersonProfileRevision @relation(fields: [profileRevisionId], references: [id])

  @@unique([profileRevisionId, dimension])
  @@index([dimension, responseStatus])
}

// Append-only agency interpretation of one source observation. This is the
// reusable mechanism for known quirks such as a special-event clicker tally;
// the parser itself never hard-codes an agency, date, or value. The newest
// revision applies, and an explicit `revoke` action restores source meaning.
model ServiceSourceResolution {
  id                     Int                  @id @default(autoincrement())
  source                 String
  sourceRecordKey        String
  revision               Int
  action                 String
  recordKind             String?
  reportedHouseholdCount Int?
  reportedPeopleCount    Int?
  eventLabel             String?
  reason                 String
  createdBy              String?
  createdAt              DateTime             @default(now())
  qualityIssueId         Int?
  qualityIssue           ServiceQualityIssue? @relation(fields: [qualityIssueId], references: [id])

  @@unique([source, sourceRecordKey, revision])
  @@index([source, sourceRecordKey, createdAt])
  @@index([qualityIssueId])
}

// Persistent, structured quality evidence attached to an activated Service
// import. Pre-activation parser findings live on the transient DataImportJob;
// only issues needed to explain active facts cross the activation boundary.
// `safeDetails` may contain counts, dates, field names, and source record keys,
// but never raw ignored-column values or notes.
model ServiceQualityIssue {
  id                Int                           @id @default(autoincrement())
  importId          Int
  source            String
  sourceRecordKey   String?
  code              String
  severity          String
  field             String?
  safeDetails       Json                          @default("{}")
  detectedAt        DateTime                      @default(now())
  import            ServiceImport                 @relation(fields: [importId], references: [id])
  sourceResolutions ServiceSourceResolution[]
  decisions         ServiceQualityIssueDecision[]

  @@index([importId, detectedAt])
  @@index([source, sourceRecordKey])
  @@index([code, severity])
}

// Append-only operator decisions. The latest revision establishes whether an
// issue is resolved, dismissed as non-impacting, or reopened; the original
// finding is never rewritten. A meaning-changing correction additionally
// links through ServiceSourceResolution.
model ServiceQualityIssueDecision {
  id        Int                 @id @default(autoincrement())
  issueId   Int
  revision  Int
  action    String
  reason    String
  createdBy String?
  createdAt DateTime            @default(now())
  issue     ServiceQualityIssue @relation(fields: [issueId], references: [id])

  @@unique([issueId, revision])
  @@index([issueId, createdAt])
}

// Stable organization-wide identity for a locally configured operational
// Service metric. Display wording and semantics live in append-only revisions;
// the key remains stable when staff only rename an alias.
model ServiceMetricDefinition {
  id              Int                                @id @default(autoincrement())
  metricKey       String                             @unique
  createdAt       DateTime                           @default(now())
  revisions       ServiceMetricDefinitionRevision[]
  observations    ServiceMetricObservationRevision[]
  capacityTargets ServiceCapacityTarget[]
}

// Stable organization-wide identity for an effective-dated capacity policy.
// WTH may revise the operating plan without rewriting the historical target
// that governed an earlier service date.
model ServiceCapacityPlan {
  id        Int                           @id @default(autoincrement())
  planKey   String                        @unique
  createdAt DateTime                      @default(now())
  revisions ServiceCapacityPlanRevision[]
}

model ServiceCapacityPlanRevision {
  id                 Int                     @id @default(autoincrement())
  planId             Int
  revision           Int
  displayName        String
  description        String?
  timezone           String
  effectiveStartDate String
  effectiveEndDate   String?
  isActive           Boolean                 @default(true)
  createdBy          String?
  createdAt          DateTime                @default(now())
  plan               ServiceCapacityPlan     @relation(fields: [planId], references: [id])
  targets            ServiceCapacityTarget[]

  @@unique([planId, revision])
  @@index([planId, effectiveStartDate, effectiveEndDate])
}

// One target within a capacity-plan revision. `metricId` is present when the
// target corresponds to a configured operational metric (for example,
// shopping visits); an overall formal household target intentionally has no
// metric relation because formal totals and operational methods stay distinct.
model ServiceCapacityTarget {
  id             Int                         @id @default(autoincrement())
  planRevisionId Int
  targetKey      String
  displayName    String
  unit           String
  targetValue    Int
  metricId       Int?
  displayOrder   Int                         @default(0)
  planRevision   ServiceCapacityPlanRevision @relation(fields: [planRevisionId], references: [id])
  metric         ServiceMetricDefinition?    @relation(fields: [metricId], references: [id])

  @@unique([planRevisionId, targetKey])
  @@index([metricId])
}

// Effective-dated metric configuration. Historical definitions are retired,
// never deleted; a meaning change creates a successor ServiceMetricDefinition.
model ServiceMetricDefinitionRevision {
  id                            Int                                @id @default(autoincrement())
  metricId                      Int
  revision                      Int
  displayName                   String
  description                   String?
  iconName                      String                             @default("package")
  valueType                     String
  unit                          String
  semanticRole                  String
  contributesToOperationalTotal Boolean                            @default(false)
  capacityTarget                Int?
  effectiveStartDate            String
  effectiveEndDate              String?
  displayOrder                  Int                                @default(0)
  isActive                      Boolean                            @default(true)
  createdBy                     String?
  createdAt                     DateTime                           @default(now())
  metric                        ServiceMetricDefinition            @relation(fields: [metricId], references: [id])
  observations                  ServiceMetricObservationRevision[]

  @@unique([metricId, revision])
  @@index([metricId, effectiveStartDate, effectiveEndDate])
  @@index([isActive, displayOrder])
}

// One immutable revision in the organization-wide metric/day observation
// history. Exactly one revision may be current for a metric/day across every
// source. A cleared revision intentionally projects as not recorded; an
// explicit numeric zero remains a recorded value with countValue = 0.
model ServiceMetricObservationRevision {
  id                   Int                             @id @default(autoincrement())
  metricId             Int
  definitionRevisionId Int
  importId             Int?
  source               String
  sourceRecordKey      String
  serviceDate          String
  revision             Int
  snapshotHash         String
  countValue           Int?
  booleanValue         Boolean?
  timeValue            String?
  sourceMetricLabel    String?
  sourceSheet          String?
  sourceCell           String?
  recordState          String                          @default("recorded")
  entryState           String                          @default("finalized")
  warningCodes         Json                            @default("[]")
  isCurrent            Boolean                         @default(true)
  recordedBy           String?
  recordedAt           DateTime                        @default(now())
  metric               ServiceMetricDefinition         @relation(fields: [metricId], references: [id])
  definitionRevision   ServiceMetricDefinitionRevision @relation(fields: [definitionRevisionId], references: [id])
  import               ServiceImport?                  @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@unique([source, sourceRecordKey, revision])
  @@index([metricId, serviceDate, isCurrent])
  @@index([definitionRevisionId])
  @@index([importId])
  @@index([entryState, serviceDate])
  @@index([snapshotHash])
}

// Append-only daily workflow state for native FEED entry. This answers whether
// the pantry was open/closed and whether staff consider that day's entry draft
// or finalized without turning missing metric rows into zeroes.
model ServiceDayStatusRevision {
  id           Int      @id @default(autoincrement())
  serviceDate  String
  revision     Int
  pantryStatus String
  entryState   String
  isCurrent    Boolean  @default(true)
  recordedBy   String?
  recordedAt   DateTime @default(now())

  @@unique([serviceDate, revision])
  @@index([serviceDate, isCurrent])
  @@index([entryState, serviceDate])
}

// Shared lifecycle for the unified Add Data workflow. These rows and their
// staged files are transient operational state, not organization data, and are
// intentionally excluded from sanitized backups. No original filename or
// source-row value is retained here.
model DataImportJob {
  id                     String                          @id @default(cuid())
  contractId             String?
  domain                 String?
  source                 String?
  datasetKind            String?
  status                 String                          @default("staging")
  fileHash               String?
  fileSizeBytes          Int                             @default(0)
  stagedFileKey          String?
  recognizedFieldCount   Int                             @default(0)
  ignoredFieldCount      Int                             @default(0)
  totalRows              Int?
  processedRows          Int                             @default(0)
  warningCount           Int                             @default(0)
  unresolvedIssueCount   Int                             @default(0)
  reviewSummary          Json?
  pendingServiceImportId Int?
  activationOutcome      String?
  activationSummary      Json?
  errorCode              String?
  errorMessage           String?
  createdBy              String?
  expiresAt              DateTime
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  completedAt            DateTime?
