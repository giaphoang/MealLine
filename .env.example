# MealLine retains the existing NOURISH_* configuration names for compatibility.
# Original PostgreSQL data is imported once, then retained for rollback.
DATABASE_URL=postgresql://127.0.0.1:5432/nourish
# Staff can use configured domains or administrator-invited allowlist accounts.
STAFF_EMAIL_DOMAINS=
NOURISH_ADMIN_EMAIL=
# Optional localhost-only developer sign-in. Ignored by npm start/production.
NOURISH_DEV_LOGIN=false
NOURISH_APP_URL=http://localhost:3003/feed
NOURISH_VOICE_API_TOKEN=
# Client self-service is separate from ingestion and remains OFF until an approved pilot.
NOURISH_CLIENT_PHONE_ENABLED=false
# Defaults to a private generated value in .nourish/runtime.json. Never a staff JWT.
NOURISH_AGENT_API_TOKEN=
# Private staff sync-queue diagnostics proxy; never a public/tunnel URL.
NOURISH_MEALLINE_URL=http://127.0.0.1:3000
# FEED email sign-in. Set these locally before sending sign-in messages.
RESEND_API_KEY=
EMAIL_FROM=
# AI provider keys are configured through the staff workspace's AI Configuration.
# Runtime database, storage and secrets default to the private .nourish directory.
