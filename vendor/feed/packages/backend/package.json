{
  "name": "@mealline/feed-backend",
  "version": "1.8.1",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:delete-operations": "vitest --run __tests__/features/shopping-lists/delete-operations.test.ts",
    "test:shopping-lists": "vitest --run __tests__/features/shopping-lists/",
    "generate:shopping-list-reference": "node scripts/generate-reference-shopping-list-pdf.mjs",
    "export:wth-tracking": "ts-node scripts/export-wth-tracking.ts",
    "validate:status-flags": "ts-node scripts/validate-status-flags.ts",
    "fix:status-flags": "ts-node scripts/fix-status-flags.ts",
    "generate:test-data": "ts-node scripts/generate-test-data.ts",
    "seed:languages": "ts-node scripts/seed-languages.ts",
    "test:bulk-retry": "ts-node scripts/test-bulk-retry.ts",
    "measure:builder-translation-heights": "ts-node scripts/measure-builder-translation-heights.ts",
    "smoke:live": "ts-node scripts/live-smoke.ts",
    "admin:list": "ts-node src/cli/admin.ts list",
    "admin:grant": "ts-node src/cli/admin.ts grant",
    "admin:revoke": "ts-node src/cli/admin.ts revoke",
    "admin:reset-access-mode": "ts-node src/cli/admin.ts reset-access-mode",
    "convert:lotto-history": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' ../../scripts/convert-lotto-snapshots.ts"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "description": "",
