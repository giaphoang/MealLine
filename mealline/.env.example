PUBLIC_BASE_URL=http://localhost:3000
MEALLINE_VOICE_TRANSPORT=twiml
MEALLINE_AGENT_URL=http://127.0.0.1:7860
# Same private 32+ character key in this file and voice_agent/.env.
# MEALLINE_AGENT_KEY=
MEALLINE_DATABASE_URL=postgres://foodfit@127.0.0.1:5432/mealline

# Optional: send confirmed intakes to MealLine using its private service token.
# This is not a staff JWT, Twilio Auth Token, or MEALLINE_AGENT_KEY.
# Run node scripts/setup-nourish.mjs /path/to/nourish, then restart MealLine.
# NOURISH_API_URL=http://127.0.0.1:3003
# NOURISH_VOICE_API_TOKEN=

# Client self-service: MealLine remains the household and fulfilment authority.
# Run `npm run phone:prepare` in the parent MealLine folder to copy its NEW key
# privately; this does not enable a pilot or change the keys above.
NOURISH_CLIENT_PHONE_ENABLED=false
NOURISH_AGENT_API_TOKEN=
# Twilio Verify service configured for SIX digits. SMS or voice callback OTP.
TWILIO_VERIFY_SERVICE_SID=

# Optional: real LLM extraction (falls back to deterministic on any failure)
# MEALLINE_MODEL_URL=https://your-model-endpoint/interpret
# MEALLINE_MODEL_KEY=

# Optional: real Twilio telephony (without these, voice uses the simulator)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1555XXXXXXX
# TWILIO_STATUS_CALLBACK_URL=https://your-public-host/api/voice/status
