# ===================================
# DOCKER DEPLOYMENT ENVIRONMENT
# ===================================

# ===================================
# PRODUCTION CONFIGURATION
# ===================================
NODE_ENV=production
PORT=3001

# ===================================
# DATABASE
# ===================================
# Docker volume mount
DATABASE_URL="file:/app/data/production.db"

# ===================================
# AUTHENTICATION
# ===================================

# JWT Secret - MUST BE UNIQUE
# Generate with: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_64_CHAR_SECRET_FROM_OPENSSL"
JWT_EXPIRES_IN="7d"

# Resend Email Service
RESEND_API_KEY="re_YOUR_ACTUAL_RESEND_KEY"
EMAIL_FROM="login@williamtemple.app"

# Application URLs
APP_URL="https://feed.williamtemple.app"
COOKIE_DOMAIN=".williamtemple.app"

# Force authentication
FORCE_AUTH=true

# ===================================
# STORAGE
# ===================================
# Docker volume mount
STORAGE_PATH="/app/storage"

# ===================================
# AI CONFIGURATION
# ===================================
# Managed in the database via Tools -> AI Configuration
# No AI API keys are required in this file
