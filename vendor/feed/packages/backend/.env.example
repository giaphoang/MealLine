# Database
DATABASE_URL="file:../dev.db"

# Server
NODE_ENV=development
PORT=3001

# Storage
STORAGE_PATH="./storage"

# Optional external root for authorized, local-only operational regression data.
# This directory must live outside the FEED repository.
# FEED_PRIVATE_DATA_DIR="/absolute/path/to/private/RealData"

# ===================================
# AUTHENTICATION (Magic Link + OTP)
# ===================================

# JWT Configuration (REQUIRED)
# Generate with: openssl rand -base64 64
JWT_SECRET="your-secret-key-here-minimum-64-characters"
JWT_EXPIRES_IN="7d"

# Email Service - Resend (REQUIRED for production)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="login@williamtemple.app"

# Application URLs
APP_URL="http://localhost:5173"
COOKIE_DOMAIN="localhost"

# Development Settings
FORCE_AUTH=false  # Set to true to require auth in development

# NOTE: Rate limiting now managed in AI Configuration database
# Configure via AI Configuration UI (tokensPerMinute, requestsPerMinute, requestsPerDay)

# NOTE: AI API keys and model settings are stored in the AIConfiguration table
# Manage via Tools -> AI Configuration in the app
