    "@prisma/client": "6.12.0",
    "@react-pdf/renderer": "4.3.0",
    "@types/puppeteer": "5.4.7",
    "@xmldom/xmldom": "0.9.12",
    "all-the-cities": "3.1.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-parse": "7.0.1",
    "docx4js": "3.3.0",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.3",
