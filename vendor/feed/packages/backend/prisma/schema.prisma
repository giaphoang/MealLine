// ===================================
// AUTHENTICATION MODELS
// ===================================

// Roles authorize actions; they never partition feature data. Every
// authenticated user still sees the same shared organization dataset (see
// AGENTS.md, "Shared Whole-Organization Environment").
//
// `accessState` is deliberately independent of AccessPolicy.mode: REVOKED
// blocks sign-in in BOTH Domain and Allowlist mode. Without it, removing a
// departed staff member does not stick, because findOrCreateUser recreates
// the row on their next successful verification.
//
// `emailVerified` records account creation, not recent activity, so it cannot
// answer "who has left?". `lastLoginAt` is the evidence input to pruning.
// An invited user has emailVerified = null, which the roster renders as
// "Invited — not yet signed in".
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  lastLoginAt   DateTime?
  role          String    @default("STAFF") // STAFF | ADMINISTRATOR
  accessState   String    @default("ALLOWED") // ALLOWED | REVOKED
  invitedAt     DateTime?
  invitedBy     String? // actor email at invite time; retained if the actor is deleted
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

model VerificationToken {
  identifier String // email address
  token      String // hashed token or OTP
  type       String // "magic_link" or "otp"
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
  @@index([expires])
}

model OtpFailure {
  email       String    @id
  attempts    Int       @default(0)
  lockedUntil DateTime?
  lastRequest DateTime  @default(now())

  @@index([email])
  @@index([lockedUntil])
}

// ===================================
// AUTHORIZATION MODELS
// ===================================

// Org-wide shared sign-in policy. A single upserted row (id = 1), following
// the ExportSettings precedent — no per-user scoping.
//
// Domain mode    — any address on the allowed domain may sign in (current
//                  behavior; the domain itself stays hardcoded until v2.0).
// Allowlist mode — only an existing, non-revoked roster row may sign in.
//
// `deniedMessage` is plain text and MUST be rendered as text, never as HTML.
// It is shown for both rejection cases; distinguishing "wrong domain" from
// "not on the list" is an accepted disclosure (the threat model is a
// compromised mailbox, whose owner already knows their own address).
model AccessPolicy {
  id            Int      @id @default(autoincrement())
  mode          String   @default("DOMAIN") // DOMAIN | ALLOWLIST
  deniedMessage String   @default("FEED access is limited to authorized staff.")
  contactEmail  String   @default("technology@williamtemple.org")
  updatedAt     DateTime @updatedAt
}

// Append-only record of privileged actions: actor, target, action, timestamp.
// The actor is stored as both id and label so rows stay legible after the
// acting user is deleted. `actorUserId` is null for non-interactive actors
// ("system:beta.4-migration", "operator:cli").
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorLabel  String
  action      String
  targetType  String // USER | ACCESS_POLICY
  targetId    String?
  targetLabel String?
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
}

// Nourish household fulfilment shares FEED inventory and the organization workspace.
model NourishIntake {
  id                 String   @id
  caseNumber         String   @unique
  clientId           String?
  reviewHold         Boolean  @default(false)
  client             NourishClient? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  changes            NourishChangeRequest[]
  language           String   @default("en")
  phone              String?
  addressRaw         String?
  addressStreet      String?
  addressCity        String?
  addressZip         String?
  householdSize      Int?
  dietaryAvoid       Json     @default("[]")
  dietaryNotes       String?
  hasStove           Boolean?
  hasFridge          Boolean?
  availabilityRaw    String?
  availabilityDays   Json     @default("[]")
  availabilityTimes  Json     @default("[]")
  contactPreference  String?
  accommodation      String?
  status             String   @default("pending")
  transcript         Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  baskets            NourishBasket[]
  deliveries         NourishDelivery[]

  @@index([status, createdAt])
  @@index([clientId, createdAt])
}

// Operational client identities are not fabricated Link2Feed/SIMC imports.
model NourishClient {
  id              String @id
  reference       String @unique
  profile         Json @default("{}")
  phone           String?
  phoneVerifiedAt DateTime?
  version         Int @default(1)
  consent         Json @default("{\"enabled\":false,\"channel\":\"none\",\"at\":\"\"}")
  mergedIntoId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  intakes         NourishIntake[]
  calls           NourishPhoneCall[]
  revisions       NourishClientRevision[]
  changes         NourishChangeRequest[]
  events          NourishDeliveryEvent[]
  @@index([phone])
  @@index([createdAt])
}

model NourishClientRevision {
  id        Int @id @default(autoincrement())
  clientId  String
  version   Int
  profile   Json
  consent   Json
  actor     String
  callId    String?
  createdAt DateTime @default(now())
  client    NourishClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  @@unique([clientId, version])
}

model NourishPhoneCall {
  id          String @id
  clientId    String?
  callSid     String?
  caseNumber  String?
  language    String @default("en")
  status      String @default("draft")
  profile     Json @default("{}")
  summary     String @default("")
  transcript  Json @default("[]")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      NourishClient? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  @@index([clientId, createdAt])
  @@index([status])
}

model NourishChangeRequest {
  id            String @id
  clientId      String?
  intakeId      String?
  kind          String
  status        String @default("pending")
  patch         Json @default("{}")
  reason        String
  decisionNotes String?
  processedBy   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        NourishClient? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  intake        NourishIntake? @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  @@index([status, createdAt])
}

// Replay receipts contain no credentials and are intentionally not portable authority.
model NourishAgentReceipt {
  id        String @id
  hash      String
  result    Json
  createdAt DateTime @default(now())
}

model NourishDeliveryEvent {
  id        Int @id @default(autoincrement())
  eventId   String @unique
  clientId  String
  intakeId  String?
  kind      String
  createdAt DateTime @default(now())
  client    NourishClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  @@index([clientId, id])
}

model NourishBasket {
  id        Int      @id @default(autoincrement())
  intakeId  String?
  title     String
  status    String   @default("draft")
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  intake    NourishIntake? @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  deliveries NourishDelivery[]

  @@index([intakeId])
  @@index([status])
}

model NourishVolunteer {
  id           String   @id
  email        String   @unique
  name         String
  role         String   @default("volunteer")
  passwordHash String?
  createdAt    DateTime @default(now())
  deliveries   NourishDelivery[]
}

model NourishDelivery {
  id             String   @id
  shoppingListId Int?
  intakeId       String?
  assignedTo     String?
  status         String   @default("pending")
  scheduledFor   DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  basket         NourishBasket? @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  intake         NourishIntake? @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  volunteer      NourishVolunteer? @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedTo])
}
