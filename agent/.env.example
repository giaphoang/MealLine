# Existing MealLine API base. The default is the local mounted FEED API.
NOURISH_BASE_URL=http://localhost:3003/feed/api
# A service-account JWT issued by MealLine. The agent sends it as auth_token
# cookie (and a Bearer header for compatible FEED deployments).
FEED_API_TOKEN=

# Pipecat providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# Twilio is used by Pipecat's Twilio serializer/runner when -t twilio is set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
